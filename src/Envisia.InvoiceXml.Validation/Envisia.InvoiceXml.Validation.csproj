<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Envisia.InvoiceXml.Validation</AssemblyName>
    <RootNamespace>Envisia.InvoiceXml.Validation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\Envisia.InvoiceXml.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Envisia.InvoiceXml.Validation</PackageId>
    <Title>Envisia.InvoiceXml.Validation – EN 16931, XRechnung and ZUGFeRD / Factur-X validator</Title>
    <Description>Validates electronic invoices (XRechnung, ZUGFeRD / Factur-X, EN 16931 in UBL and CII syntax) against the official XML schemas and Schematron rules and creates validation reports in the format of the KoSIT validator (XML and HTML). Pure .NET: ships its own XPath 2.0 and ISO Schematron engine, no Java required.</Description>
    <PackageTags>en16931;e-invoice;einvoice;e-rechnung;zugferd;factur-x;facturx;xrechnung;cii;ubl;invoice;xml;validator;validation;schematron;kosit</PackageTags>
    <PackageLicenseExpression>Apache-2.0 AND EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/envisia/ZUGFeRD-csharp/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Envisia.InvoiceXml\Envisia.InvoiceXml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official validation artefacts (XML schemas, Schematron rules and code lists) are embedded and
         addressed by their path below Resources/, e.g. "xrechnung/schematron/ubl/XRechnung-UBL-validation.sch". -->
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\**\*.md">
      <LogicalName>$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\','/'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="Resources\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Envisia.InvoiceXml.Tests, " />
  </ItemGroup>
</Project>
