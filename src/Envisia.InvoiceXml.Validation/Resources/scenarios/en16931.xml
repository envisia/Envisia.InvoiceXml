<?xml version="1.0" encoding="UTF-8"?>
<!--
  Validation scenarios for EN 16931 invoices of any CIUS or extension (CustomizationID / guideline identifier
  starting with urn:cen.eu:en16931:2017, e.g. Peppol BIS Billing 3.0), in the configuration format of the KoSIT
  validator. Only the XML schema and the CEN EN 16931 rules 1.3.16 are checked, not the rules of the CIUS.
  Resource locations are relative to the embedded Resources/ folder.
  -->
<scenarios xmlns="http://www.xoev.de/de/validator/framework/1/scenarios" frameworkVersion="1.0.0">
  <name>Validator Configuration EN 16931</name>
  <author>envisia GmbH</author>
  <date>2026-10-08</date>
  <description>
    <p>Checks whether XML documents conform to EN 16931 (UBL 2.1 Invoice and CreditNote, UN/CEFACT CII D16B).</p>
    <p>It uses CEN Schematron rules of urn:cen.eu:en16931:2017 in version 1.3.16
      (https://github.com/ConnectingEurope/eInvoicing-EN16931/releases/tag/validation-1.3.16).</p>
  </description>

  <scenario>
    <name>EN16931 CIUS (UBL Invoice)</name>
    <description>
      <p>Validates UBL Invoice 2.1 documents whose CustomizationID starts with urn:cen.eu:en16931:2017.</p>
      <p>Uses the UBL Invoice 2.1 XML Schema and the Schematron rules from EN16931:2017 (UBL) 1.3.16.</p>
    </description>
    <namespace prefix="cbc">urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2</namespace>
    <namespace prefix="invoice">urn:oasis:names:specification:ubl:schema:xsd:Invoice-2</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/invoice:Invoice[starts-with(normalize-space(cbc:CustomizationID), 'urn:cen.eu:en16931:2017')])</match>
    <validateWithXmlSchema>
      <resource>
        <name>XML Schema for UBL 2.1 Invoice</name>
        <location>ubl/2.1/xsd/maindoc/UBL-Invoice-2.1.xsd</location>
      </resource>
    </validateWithXmlSchema>
    <validateWithSchematron>
      <resource>
        <name>Schematron rules for EN16931 (UBL)</name>
        <location>en16931/ubl/EN16931-UBL-validation.sch</location>
      </resource>
    </validateWithSchematron>
    <createReport>
      <resource>
        <name>Validation report for EN16931 (UBL Invoice)</name>
        <location>builtin:xrechnung-report</location>
      </resource>
    </createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <scenario>
    <name>EN16931 CIUS (UBL CreditNote)</name>
    <description>
      <p>Validates UBL CreditNote 2.1 documents whose CustomizationID starts with urn:cen.eu:en16931:2017.</p>
      <p>Uses the UBL CreditNote 2.1 XML Schema and the Schematron rules from EN16931:2017 (UBL) 1.3.16.</p>
    </description>
    <namespace prefix="cbc">urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2</namespace>
    <namespace prefix="creditnote">urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/creditnote:CreditNote[starts-with(normalize-space(cbc:CustomizationID), 'urn:cen.eu:en16931:2017')])</match>
    <validateWithXmlSchema>
      <resource>
        <name>XML Schema for UBL 2.1 CreditNote</name>
        <location>ubl/2.1/xsd/maindoc/UBL-CreditNote-2.1.xsd</location>
      </resource>
    </validateWithXmlSchema>
    <validateWithSchematron>
      <resource>
        <name>Schematron rules for EN16931 (UBL)</name>
        <location>en16931/ubl/EN16931-UBL-validation.sch</location>
      </resource>
    </validateWithSchematron>
    <createReport>
      <resource>
        <name>Validation report for EN16931 (UBL CreditNote)</name>
        <location>builtin:xrechnung-report</location>
      </resource>
    </createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <scenario>
    <name>EN16931 CIUS (CII)</name>
    <description>
      <p>Validates UN/CEFACT Cross Industry Invoice D16B documents whose guideline identifier starts with
        urn:cen.eu:en16931:2017.</p>
      <p>Uses the UN/CEFACT (SCRDM - CII uncoupled) D16B XML Schema and the Schematron rules from EN16931:2017 (CII) 1.3.16.</p>
    </description>
    <namespace prefix="rsm">urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100</namespace>
    <namespace prefix="ram">urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/rsm:CrossIndustryInvoice[starts-with(normalize-space(rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID), 'urn:cen.eu:en16931:2017')])</match>
    <validateWithXmlSchema>
      <resource>
        <name>XML Schema for UN/CEFACT XML (SCRDM - CII uncoupled)</name>
        <location>cii/d16b/xsd/CrossIndustryInvoice_100pD16B.xsd</location>
      </resource>
    </validateWithXmlSchema>
    <validateWithSchematron>
      <resource>
        <name>Schematron rules for EN16931 (CII)</name>
        <location>en16931/cii/EN16931-CII-validation.sch</location>
      </resource>
    </validateWithSchematron>
    <createReport>
      <resource>
        <name>Validation report for EN16931 (CII)</name>
        <location>builtin:xrechnung-report</location>
      </resource>
    </createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>
  <noScenarioReport>
    <resource>
      <name>Default Report</name>
      <location>builtin:default-report</location>
    </resource>
  </noScenarioReport>
</scenarios>
