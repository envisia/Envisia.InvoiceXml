<Project Sdk="Microsoft.NET.Sdk">
  <!-- The KoSIT prototype conformance tests (prototypes/kosit-testsuite) run against the native library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/KositNative/KositNative.csproj" />
    <Compile Include="../../kosit-testsuite/src/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
