<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <Authors>envisia</Authors>
    <Company>envisia</Company>
    <Product>Envisia.InvoiceXml</Product>
    <Copyright>Copyright © envisia and the ZUGFeRD-csharp contributors</Copyright>
    <Version>1.0.0</Version>

    <RepositoryUrl>https://github.com/envisia/ZUGFeRD-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/envisia/ZUGFeRD-csharp</PackageProjectUrl>

    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Reproducible builds on CI (SourceLink paths, deterministic output). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
